# Shared Java/BFF/tooling configuration template. No credentials are bundled.
# Copy to ai/.env; never commit that real file. Java reads cwd/.env then parent/.env.
# BFF/tool launchers locate this directory explicitly with SCENIC_GUIDE_JAVA_DIR.
# Existing process/JVM values take precedence. Optional values mirror public code defaults.
# Required secrets must be generated/provided locally; blank values deliberately fail validation.

# REQUIRED_LOCAL_CORE
# JWT_SECRET: random secret, at least 32 UTF-8 bytes. YUYOUZHICE_AUTH_SECRET is BFF-only.
# DEEPSEEK_API_KEY is currently required by Spring AI bean initialization, even before chat.
# Startup readiness with a placeholder is not proof of working provider authentication.
JWT_SECRET=
DEEPSEEK_API_KEY=
YUYOUZHICE_AUTH_SECRET=
# Local development value only. Production/hosted BFF requires an explicit Java URL;
# no deployment-specific remote address is selected when this setting is absent.
CORE_BACKEND_URL=http://127.0.0.1:8080

# OPTIONAL_FEATURE
# Provider credentials are blank; endpoints are public defaults, not verified availability.
# Java Qdrant uses gRPC HOST/PORT; tooling uses REST URL. Keep collection names aligned.
AMAP_WEB_JS_KEY=
AMAP_WEB_JS_SECURITY_CODE=
AMAP_WEB_SERVICE_BASE_URL=https://restapi.amap.com
AMAP_WEB_SERVICE_EMPTY_ROUTE_CACHE_TTL_MS=5000
AMAP_WEB_SERVICE_HYDRATION_CONCURRENCY=8
AMAP_WEB_SERVICE_HYDRATION_QUEUE_CAPACITY=64
AMAP_WEB_SERVICE_HYDRATION_ROUTE_TIMEOUT_MS=15000
AMAP_WEB_SERVICE_KEY=
AMAP_WEB_SERVICE_MAX_CONCURRENCY=16
AMAP_WEB_SERVICE_POI_CACHE_TTL_MS=1800000
AMAP_WEB_SERVICE_POI_MAX_KEYWORDS=3
AMAP_WEB_SERVICE_QPS_COOLDOWN_MS=2000
AMAP_WEB_SERVICE_REQUEST_CACHE_ENABLED=true
AMAP_WEB_SERVICE_REQUEST_CACHE_MAX_ENTRIES=2048
AMAP_WEB_SERVICE_REQUEST_DEDUP_ENABLED=true
AMAP_WEB_SERVICE_ROUTE_CACHE_TTL_MS=1800000
AMAP_WEB_SERVICE_ROUTE_TIMEOUT_MS=4500
AMAP_WEB_SERVICE_TIMEOUT_MS=5000
AMAP_WEB_SERVICE_WEATHER_CACHE_TTL_MS=600000
APP_DEFAULT_LANGUAGE=zh
APP_DEFAULT_MAX_UPLOAD_SIZE_MB=50
APP_DEFAULT_SITE_NAME=渝游智策
APP_KNOWLEDGE_SYNC_ENABLED=true
APP_TTS_ENABLED=true
BAIDU_API_KEY=
BAIDU_ASR_URL=https://vop.baidu.com/server_api
BAIDU_CONNECT_TIMEOUT_MS=5000
BAIDU_READ_TIMEOUT_MS=15000
BAIDU_SECRET_KEY=
BAIDU_TOKEN_URL=https://aip.baidubce.com/oauth/2.0/token
BAIDU_TTS_URL=https://tsn.baidu.com/text2audio
BAIDU_WEB_FAVICON_URL=https://www.baidu.com/favicon.ico
BAIDU_WEB_SEARCH_URL=https://www.baidu.com/s
BAILIAN_CONNECT_TIMEOUT_MS=3000
BAILIAN_READ_TIMEOUT_MS=3000
BAILIAN_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
CHAT_STREAM_TIMEOUT_MS=120000
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MAX_TOKENS=8192
DEEPSEEK_MODEL=deepseek-v4-flash
KNOWLEDGE_DB_PASSWORD=
KNOWLEDGE_DB_TYPE=sqlite
KNOWLEDGE_DB_URL=
KNOWLEDGE_DB_USERNAME=
KNOWLEDGE_INDEX_EXECUTOR_CORE_SIZE=1
KNOWLEDGE_INDEX_EXECUTOR_MAX_SIZE=2
KNOWLEDGE_INDEX_EXECUTOR_QUEUE_CAPACITY=8
KNOWLEDGE_RETRIEVAL_EXCERPT_CHARS=4096
KNOWLEDGE_RETRIEVAL_MAX_CANDIDATES=200
KNOWLEDGE_SQLITE_BUSY_TIMEOUT_MS=5000
KNOWLEDGE_UPLOAD_DIR=uploads/knowledge
MEMORY_CONTENT_MAX_CHARS=6000
MEMORY_PROMPT_MAX_CHARS=6000
PLANNER_GEO_CENTROID_MAX_SPAN_METERS=50000
PLANNER_LLM_EXECUTOR_CORE_SIZE=2
PLANNER_LLM_EXECUTOR_MAX_SIZE=4
PLANNER_LLM_EXECUTOR_QUEUE_CAPACITY=16
PLANNER_LLM_INTENT_ENABLED=false
PLANNER_LLM_INTENT_MINIMUM_CONFIDENCE=0.75
PLANNER_LLM_INTENT_TIMEOUT_MS=3500
RAG_SEMANTIC_ENABLED=true
# DeepSeek request extension; false for providers without thinking.type.
RAG_SEMANTIC_DISABLE_THINKING=true
RAG_SEMANTIC_TIMEOUT_MS=15000
RAG_SEMANTIC_MAX_OUTPUT_CHARS=8000
PLANNER_LLM_NARRATIVE_ENABLED=false
PLANNER_LLM_NARRATIVE_TIMEOUT_MS=30000
PLANNER_REQUEST_TIMEOUT_MS=45000
PLANNER_RUNTIME_LONG_BUDGET_MINUTES=300
PLANNER_RUNTIME_LONG_PAGE_COUNT=3
PLANNER_RUNTIME_LONG_RADIUS_METERS=8000
PLANNER_RUNTIME_MAX_CANDIDATES=40
PLANNER_RUNTIME_MEDIUM_BUDGET_MINUTES=180
PLANNER_RUNTIME_MEDIUM_PAGE_COUNT=3
PLANNER_RUNTIME_MEDIUM_RADIUS_METERS=6000
PLANNER_RUNTIME_SEARCH_RADIUS_METERS=6000
PLANNER_RUNTIME_SHORT_PAGE_COUNT=2
PLANNER_RUNTIME_SHORT_RADIUS_METERS=4000
PLANNER_V1_ENABLED=true
PORT=3000
QDRANT_API_KEY=
QDRANT_COLLECTION=scenic_guide_production_v3_rebuild
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_PRODUCTION_V2_AUTO_CREATE_INDEXES=false
QDRANT_PRODUCTION_V2_COLLECTION=scenic_guide_production_v3_rebuild
QDRANT_URL=
QDRANT_USE_TLS=
RETRIEVAL_BENCHMARK_COLLECTION=scenic_guide_production_v3_rebuild
RETRIEVAL_BENCHMARK_TIMEOUT_MS=30000
TRIP_PLAN_MAX_DAYS=30
TRIP_PLAN_MAX_JSON_BYTES=2097152
TRIP_PLAN_MAX_STOPS_PER_DAY=40
TRIP_PLAN_MAX_TEXT_CHARS=20000
TRIP_PLAN_MAX_TOTAL_STOPS=500
YUYOUZHICE_CORPUS_FILE=
YUYOUZHICE_DATA_FILE=
YUYOUZHICE_EMBEDDING_API_KEY=
YUYOUZHICE_EMBEDDING_BATCH_SIZE=10
YUYOUZHICE_EMBEDDING_DIMENSION=1536
YUYOUZHICE_EMBEDDING_MANIFEST_FILE=
YUYOUZHICE_EMBEDDING_MODEL=text-embedding-v2
YUYOUZHICE_EMBEDDING_PROVIDER=dashscope
YUYOUZHICE_EMBEDDING_URL=
YUYOUZHICE_IMPORT_TIMEOUT_MS=30000
YUYOUZHICE_JAVA_STREAM_TIMEOUT_MS=65000
YUYOUZHICE_JAVA_TIMEOUT_MS=4000
YUYOUZHICE_LOG_FILE=
# local state store: 1 disables disk persistence on every port; 0 enables it.
# The explicitly selected redis state store uses Redis regardless of this local-only switch.
YUYOUZHICE_MEMORY=0
YUYOUZHICE_REDIS_DATABASE=0
YUYOUZHICE_REDIS_HOST=localhost
YUYOUZHICE_REDIS_KEY_PREFIX=yuyouzhice:revoked:
YUYOUZHICE_REDIS_PASSWORD=
YUYOUZHICE_REDIS_PORT=6379
YUYOUZHICE_REDIS_SSL=false
YUYOUZHICE_REDIS_TIMEOUT_MS=5000
YUYOUZHICE_REDIS_URL=
YUYOUZHICE_REVOKE_STORE=memory
# local keeps one BFF process; redis shares web auth, planner mappings and trip workspace.
# Feedback and diagnostic metrics remain process-local; use the existing dedicated Redis settings.
YUYOUZHICE_BFF_STATE_STORE=local
YUYOUZHICE_SESSION_TTL_MS=604800000
YUYOUZHICE_SOURCE_REGISTER_FILE=
YUYOUZHICE_WEB_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional PDF font override. Empty uses the bundled Chinese font; do not configure an OS-specific default.
# Set an absolute, readable, embeddable Chinese TTF or TTC path (TTC includes face index, e.g. ,0).
# Restart the application after changing the font. An invalid explicit override fails export.
PDF_FONT_FILE=

# LEGACY_ALIAS
# Commented compatibility names; set only when migrating. Canonical names take precedence.
# Do not enable blank canonical assignments and an alias simultaneously: Java placeholders fall back on absence, not empty text.
# AMAP_JS_KEY=
# AMAP_JS_SECURITY_KEY=
# AMAP_KEY=
# BAILIAN_API_KEY=
# BAILIAN_EMBEDDING_MODEL=
# DASHSCOPE_EMBEDDING_DIMENSION=
# DASHSCOPE_EMBEDDING_MODEL=
# DATABASE_URL=
# OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=
# POSTGRES_CONNECTION_STRING=
# POSTGRES_DATABASE=
# POSTGRES_DB=
# POSTGRES_HOST=
# POSTGRES_JDBC_URL=
# POSTGRES_PASSWORD=
# POSTGRES_PORT=5432
# POSTGRES_URI=
# POSTGRES_URL=
# POSTGRES_USER=
# POSTGRES_USERNAME=
# QDRANT_PROTOCOL=
# QDRANT_SCHEME=
# REDIS_DATABASE=0
# REDIS_HOST=localhost
# REDIS_PASSWORD=
# REDIS_PORT=6379
# REDIS_SSL=false
# REDIS_TIMEOUT_MS=5000
# YUYOUZHICE_JAVA_CORE_URL=
# YUYOUZHICE_QDRANT_API_KEY=
# YUYOUZHICE_QDRANT_SCHEME=
# YUYOUZHICE_QDRANT_URL=
# YUYOUZHICE_TOKEN_TTL_MS=
# YUYOUZHICE_VECTOR_STORE_COLLECTION=

# PRODUCTION_ONLY
# Bootstrap is disabled by default. Redis revocation requires shared Redis on all nodes.
ADMIN_BOOTSTRAP_MODE=disabled
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
JWT_REVOCATION_REDIS_ENABLED=false
